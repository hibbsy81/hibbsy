    { "src": "countdown-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "countdown-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "countdown-favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
